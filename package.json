{
  "name": "@kinex/workspace-sdk",
  "version": "0.1.0",
  "description": "KiNex Workspace Hub integration for app frontends: allowed_apps, app access gate, app switcher data, Clerk token and sign-in helpers. Headless (no UI) and independent of the Clerk package version.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinex-ai-space/kin-workspace-sdk.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:public": "node scripts/check-public.mjs",
    "prepack": "node scripts/check-public.mjs && npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "pack:release": "npm pack"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
