{
  "name": "@kinex-ai/workspace-sdk",
  "version": "0.2.1",
  "description": "KiNex Workspace Hub integration. Frontend: allowed_apps, app access gate, app switcher data, Clerk token and sign-in helpers (headless, Clerk-version independent). Server (Node): Kin contract types, sync-user parsing, internal key check, issuer-only Clerk JWT verification.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinex-ai-space/kin-workspace-sdk.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepack": "node scripts/check-secrets.mjs && npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "pack:release": "npm pack"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "module": "./dist/index.js",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.cts"
      ],
      "server": [
        "./dist/server/index.d.cts"
      ]
    }
  }
}
